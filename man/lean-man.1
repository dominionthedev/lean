.TH "LEAN" "1" "Oct 2026" "lean" "lean Manual"

.SH NAME
lean-man - Generate or view man pages


.SH SYNOPSIS
\fBlean man [flags]\fP


.SH DESCRIPTION
Generate man pages for lean and its subcommands, or open the system man page.

.PP
Examples:
  lean man                  # open 'man lean' if installed
  lean man --generate       # write man pages to ./man
  lean man --generate -o /usr/local/share/man/man1


.SH OPTIONS
\fB--generate\fP[=false]
	Generate man pages instead of opening them

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for man

.PP
\fB-o\fP, \fB--output\fP=""
	Output directory for generated man pages (implies --generate)


.SH SEE ALSO
\fBlean(1)\fP


