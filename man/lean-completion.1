.TH "LEAN" "1" "Oct 2026" "lean" "lean Manual"

.SH NAME
lean-completion - Generate completion script


.SH SYNOPSIS
\fBlean completion [bash|zsh|fish|powershell]\fP


.SH DESCRIPTION
To load completions:

.PP
Bash:

.PP
$ source <(lean completion bash)


.SH To load completions for each session, add this to your .bashrc:
$ lean completion bash > /etc/bash_completion.d/lean

.PP
Zsh:


.SH If shell completion is not already enabled in your environment you will need

.SH to enable it.  You can execute the following once:
$ echo "autoload -U compinit; compinit" >> ~/.zshrc


.SH To load completions for each session, add this to your .zshrc:
$ lean completion zsh > "${fpath[1]}/_lean"

.PP
Fish:

.PP
$ lean completion fish > ~/.config/fish/completions/lean.fish

.PP
PowerShell:

.PP
PS> lean completion powershell | Out-String | Invoke-Expression


.SH To load completions for every new session, run:
PS> lean completion powershell > lean.ps1


.SH and source this file from your PowerShell profile.

.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for completion


.SH SEE ALSO
\fBlean(1)\fP


