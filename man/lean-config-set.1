.TH "LEAN" "1" "Oct 2026" "lean" "lean Manual"

.SH NAME
lean-config-set - Update Lean configuration settings

.SH SYNOPSIS
\fBlean config set [flags]\fP

.SH DESCRIPTION
Update project-local settings by default. Use --global for user-level settings.

.SH OPTIONS
\fB--default-profile\fP=""
	Default project profile

\fB-g\fP, \fB--global\fP[=false]
	Update global configuration

\fB--editor\fP=""
	Global editor command

\fB-h\fP, \fB--help\fP[=false]
	help for set

\fB--master-key-file\fP=""
	Global local-backend master key path

\fB--output-format\fP=""
	Project output format: text | json

\fB--schema-path\fP=""
	Project schema path

\fB--secrets-backend\fP=""
	Global secrets backend: local | gpg | age | ssh

\fB--secrets-identity\fP=""
	Global age identity or SSH private-key path

\fB--secrets-recipient\fP=""
	Global GPG/age recipient or SSH public-key path

.SH EXAMPLES
  lean config set --default-profile development
  lean config set --schema-path .lean/schema.toml
  lean config set --global --editor nvim
  lean config set --global --secrets-backend age

.SH SEE ALSO
\fBlean-config(1)\fP

.SH HISTORY
2-Oct-2026 Updated for split local/global configuration
